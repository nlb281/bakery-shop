<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:bakeryShop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
        x:Class="bakeryShop.Views.InputOrderedQuantity"
        x:DataType="vm:InputOrderedQuantityViewModel"
        Title="InputOrderedQuantity"
        Icon="/Assets/avalonia-logo.ico"
        Width="300"
        Height="350">
    <Grid RowDefinitions="50, *, 50">
        <StackPanel Grid.Row="0">
            <TextBlock Text="Количество товара" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Margin="15,20,0,15"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Grid.Row="1" Spacing="15">
            <TextBox Text="{Binding OrderedQuantity}" HorizontalAlignment="Center" Watermark="Введите  кол-во товара" 
                     BorderThickness="1"
                     CornerRadius="8"
                     Width="240"
                     Padding="10"
                     FontSize="16"/>
            <Button 
                Click="ConfirmOrder"
                Content="Подтвердить" 
                Width="150"  
                FontSize="15" 
                FontWeight="500" 
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center" 
                VerticalContentAlignment="Center"
                Background="#242121"
                Foreground="#fff"
                Padding="8"
                Margin="0 0 15 0"/>
        </StackPanel>
    </Grid>
    
</Window>
